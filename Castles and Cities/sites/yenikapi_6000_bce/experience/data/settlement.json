  "snapshot_kind": "dated_interpretation",
  "nominal_year_bce": 6000,
  "authoring_category": "village",
  "title": "Yenikapı · circa 6000 BCE",
  "subtitle": "An early-settlement interpretation on Istanbul’s historic peninsula",
  "datum_note": "Local metres, x east / y up / z south. Sea surface y=0 is an authoring datum, not present sea level. No surveyed georeference.",
  "terrain": {
    "extent": 240,
    "grid": 2,
    "shore_z": 112,
    "stream_x": 48,
    "stream_width": 4.0,
    "walk_limit": 170
  },
  "sources": [
    {
      "id": "yenikapi_excavation",
      "class": "direct",
      "title": "Başaran and Kızıltan, The Archaeology of the Historic Peninsula, 2016, pp. 49–53",
      "url": "https://www.ancientportsantiques.com/wp-content/uploads/Documents/PLACES/Bosphorus-BlackSea/Yenikapi-Basaran2016.pdf",
      "claim": "Yenikapı preserves small timber-supported rooms, stone footing traces, wattle and daub, pottery, grinding tools and paddles. The rendered arrangement is not an excavated plan."
    },
    {
      "id": "algan_coast",
      "class": "direct",
      "title": "Algan et al., Holocene coastal change, Quaternary Research 76 (2011), 30–45",
      "url": "https://doi.org/10.1016/j.yqres.2011.04.002",
      "claim": "A lower coastal plain and stream preceded marine inundation. This model uses a local, hypothetical waterline and datum; neither the modern nor Byzantine harbor outline is reused."
    },
    {
      "id": "ozdogan_marmara",
      "class": "regional_analogy",
      "title": "Özdoğan, Archaeological Evidence on the Westward Expansion of Farming Communities, 2011",
      "url": "https://doi.org/10.1086/658895",
      "claim": "Marmara comparisons inform timber/earthen building traditions and mixed farming, fishing and gathering. Roofs, field placement and domestic arrangements remain interpretation."
    },
    {
      "id": "donmez_chronology",
      "class": "direct",
      "title": "Dönmez, The Protohistoric Times of Istanbul in the Light of New Evidence, 2017",
      "url": "https://dergipark.org.tr/tr/download/article-file/1726443",
      "claim": "The reported Neolithic range includes circa 6000 BCE. This nominal date does not date each represented object or assert the first year of settlement."
    }
  ],
