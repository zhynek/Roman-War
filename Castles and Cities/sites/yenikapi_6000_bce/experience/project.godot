; Standalone visual authoring study. No Roman War campaign or save imports.
config_version=5

[application]
config/name="Yenikapı — Early Settlement"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/version="0.10.0"
config/use_custom_user_dir=true
config/custom_user_dir_name="Roman War Yenikapi Early Settlement"

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1600
window/size/window_height_override=1000
window/size/resizable=true
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.47, 0.66, 0.7, 1)
