{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "interpretation",
    "room",
    "stages",
    "projects",
    "ui"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "building",
        "board_at",
        "easel_at",
        "page_size"
      ],
      "properties": {
        "building": {
          "type": "string",
          "minLength": 1
        },
        "board_at": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "easel_at": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "page_size": {
          "const": 8
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "building",
        "adapt",
        "path",
        "ground",
        "screen",
        "repair",
        "equipment"
      ],
      "properties": {
        "building": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adapt": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
