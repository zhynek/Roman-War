{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roman-war.local/constantinople/city.schema.json",
  "title": "Independent Constantinople city-authoring data",
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "hill": {
      "type": "object",
      "properties": {
        "position_m": {
          "$ref": "#/$defs/point"
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "position_m",
        "height_m",
        "radius_m"
      ],
      "additionalProperties": false
    },
    "road": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "points_m": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 2
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "points_m",
        "width_m",
        "evidence"
      ],
      "additionalProperties": false
    },
    "wall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "points_m": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 2
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tower_spacing_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "points_m",
        "width_m",
        "height_m",
        "tower_spacing_m",
        "evidence"
      ],
      "additionalProperties": false
    },
    "district": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "polygon_m": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 3
        },
        "density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "style": {
          "enum": [
            "urban",
            "merchant",
            "workshop",
            "courtyard",
            "garden"
          ]
        },
        "grid_rotation_deg": {
          "type": "number"
        },
        "plot_pitch_m": {
          "type": "number",
          "minimum": 20
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "polygon_m",
        "density",
        "style",
        "grid_rotation_deg",
        "plot_pitch_m",
        "evidence"
      ],
      "additionalProperties": false
    },
    "landmark": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "hagia_sophia",
            "hippodrome",
            "church",
            "monastery",
            "palace",
            "cistern",
            "aqueduct",
            "column",
            "gate"
          ]
        },
        "position_m": {
          "$ref": "#/$defs/point"
        },
        "rotation_deg": {
          "type": "number"
        },
        "dimensions": {
          "type": "object",
          "properties": {
            "width_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "octagonal_gallery": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "adjoining_sanctuaries": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "cruciform_five_domes": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "gallery_height_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dome_compartments": {
              "type": "integer",
              "enum": [
                16
              ]
            }
          },
          "required": [
            "width_m",
            "depth_m",
            "height_m"
          ],
          "additionalProperties": {
            "type": "number"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "tour_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "exclusion_margin_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "position_m",
        "rotation_deg",
        "dimensions",
        "description",
        "evidence",
        "source_ids",
        "tour_distance_m",
        "exclusion_margin_m"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "accessed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "accessed"
      ],
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "density_multiplier": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        },
        "hypothetical": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "density_multiplier",
        "hypothetical"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "polygon_m": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 3
        },
        "kind": {
          "enum": [
            "fields",
            "orchard",
            "gardens"
          ]
        }
      },
      "required": [
        "id",
        "polygon_m",
        "kind"
      ],
      "additionalProperties": false
    },
    "harbor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "position_m": {
          "$ref": "#/$defs/point"
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depth_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation_deg": {
          "type": "number"
        },
        "piers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "position_m",
        "width_m",
        "depth_m",
        "rotation_deg",
        "piers",
        "count",
        "description",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "context_land": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "polygon_m": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 3
        },
        "base_height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "coast_falloff_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hill"
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "polygon_m",
        "base_height_m",
        "coast_falloff_m",
        "hills",
        "evidence",
        "source_ids"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "reference_year_ce": {
      "const": 1200
    },
    "approximation_notice": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_system": {
      "type": "object",
      "properties": {
        "axes": {
          "const": "east_north_up"
        },
        "units": {
          "const": "metres"
        },
        "origin_name": {
          "type": "string",
          "minLength": 1
        },
        "modern_anchor_latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "modern_anchor_longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "surveyed": {
          "const": false
        }
      },
      "required": [
        "axes",
        "units",
        "origin_name",
        "modern_anchor_latitude_deg",
        "modern_anchor_longitude_deg",
        "source_id",
        "surveyed"
      ],
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "properties": {
        "boundary_m": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 3
        },
        "hills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hill"
          },
          "minItems": 1
        },
        "sea_level_m": {
          "const": 0
        },
        "base_height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "coast_falloff_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "western_land_edge_m": {
          "type": "number"
        },
        "generation": {
          "type": "object",
          "properties": {
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "max_buildings": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 50000
            },
            "max_trees": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15000
            },
            "tree_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000
            },
            "coast_clearance_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "road_setback_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "wall_setback_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "landmark_margin_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "house_gap_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "lane_every_x": {
              "type": "integer",
              "minimum": 3,
              "maximum": 20
            },
            "lane_every_y": {
              "type": "integer",
              "minimum": 3,
              "maximum": 20
            },
            "lane_width_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "seed",
            "max_buildings",
            "max_trees",
            "tree_attempts",
            "coast_clearance_m",
            "road_setback_m",
            "wall_setback_m",
            "landmark_margin_m",
            "house_gap_m",
            "lane_every_x",
            "lane_every_y",
            "lane_width_m"
          ],
          "additionalProperties": false
        },
        "context_land": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context_land"
          }
        }
      },
      "required": [
        "boundary_m",
        "hills",
        "sea_level_m",
        "base_height_m",
        "coast_falloff_m",
        "western_land_edge_m",
        "generation"
      ],
      "additionalProperties": false
    },
    "roads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/road"
      },
      "minItems": 1
    },
    "walls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wall"
      },
      "minItems": 1
    },
    "districts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/district"
      },
      "minItems": 1
    },
    "landmarks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/landmark"
      },
      "minItems": 20
    },
    "harbors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/harbor"
      },
      "minItems": 2
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 6
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      },
      "minItems": 3
    },
    "initial_focus": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "visuals": {
      "type": "object"
    },
    "palette": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "subtitle",
    "reference_year_ce",
    "approximation_notice",
    "coordinate_system",
    "site",
    "roads",
    "walls",
    "districts",
    "landmarks",
    "harbors",
    "fields",
    "sources",
    "stages",
    "initial_focus"
  ],
  "additionalProperties": false
}
