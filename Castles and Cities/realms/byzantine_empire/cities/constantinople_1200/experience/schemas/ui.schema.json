{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roman-war.local/constantinople/ui.schema.json",
  "title": "Standalone city interface strings",
  "description": "The current interface vocabulary includes direct calls and keys selected dynamically by camera, editor kit and status. Additional translation strings may be added; every value must remain nonblank text.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "required": [
    "app_title",
    "app_subtitle",
    "loading",
    "historical_scope",
    "places_title",
    "places_note",
    "inspector_title",
    "inspector_collapse",
    "inspector_expand",
    "inspector_toggle_hint",
    "inspector_empty",
    "evidence_label",
    "cutaway_label",
    "cutaway_note",
    "sources_label",
    "source_button",
    "focus_button",
    "interior_button",
    "interior_note",
    "tour_button",
    "overview_button",
    "plan_button",
    "home_button",
    "stage_label",
    "time_label",
    "quality_label",
    "nav_label",
    "nav_orbit",
    "nav_fly",
    "nav_walk",
    "edit_button",
    "editor_title",
    "editor_note",
    "kit_label",
    "kit_house",
    "kit_workshop",
    "kit_church",
    "kit_tower",
    "place_button",
    "select_button",
    "rotation_label",
    "scale_label",
    "rotate_button",
    "delete_button",
    "undo_button",
    "save_button",
    "load_button",
    "clear_button",
    "selected_template",
    "nothing_selected",
    "count_template",
    "saved",
    "loaded",
    "save_error",
    "load_missing",
    "load_error",
    "load_clamped",
    "placement_limit",
    "placed",
    "pick_addition",
    "placement_active",
    "placement_outside",
    "deleted",
    "cleared",
    "undone",
    "stage_template",
    "time_template",
    "stats_template",
    "ready",
    "camera_view",
    "data_error",
    "screenshot_saved",
    "screenshot_error",
    "help_orbit",
    "help_fly",
    "help_walk",
    "walk_note",
    "open_folder_button",
    "close_editor",
    "distance_template",
    "historical_label",
    "creative_label"
  ],
  "additionalProperties": {
    "type": "string",
    "minLength": 1,
    "pattern": "\\S"
  }
}
