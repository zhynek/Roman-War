{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offices.schema.json",
  "title": "Senate offices",
  "type": "object",
  "required": ["offices"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "offices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "rank", "seats", "min_age", "effects", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "seats": { "type": "integer", "minimum": 1, "maximum": 8 },
          "min_age": { "type": "integer", "minimum": 16 },
          "effects": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": { "type": "number" },
              "management": { "type": "number" },
              "influence": { "type": "number" },
              "troop_morale": { "type": "number" },
              "law": { "type": "number" },
              "happiness": { "type": "number" }
            }
          },
          "description": { "type": "string" }
        }
      }
    }
  }
}
