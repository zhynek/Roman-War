{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offices.schema.json",
  "title": "Senate offices (the cursus honorum)",
  "description": "The magistracies the Senate fills each summer from the men of the Roman houses. Ranks order the ladder (highest fills first); seats are how many hold the office at once; requires_prior_rank is the cursus honorum (0 = open to any man of age), waived only when no candidate on the ladder remains. Effects reach a holder through CharacterRules.effect_total like traits and retinue.",
  "type": "object",
  "required": ["offices"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "offices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "rank", "seats", "min_age", "requires_prior_rank", "effects", "description", "historical_basis"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "seats": { "type": "integer", "minimum": 1, "maximum": 8 },
          "min_age": { "type": "integer", "minimum": 16 },
          "requires_prior_rank": { "type": "integer", "minimum": 0 },
          "effects": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": { "type": "number" },
              "management": { "type": "number" },
              "influence": { "type": "number" }
            }
          },
          "description": { "type": "string", "minLength": 1 },
          "historical_basis": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
