{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "role",
    "fiction_note",
    "future_note",
    "ui",
    "status",
    "intro",
    "lesson_counsel",
    "limits",
    "lessons"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "const": "marcus"
    },
    "name": {
      "$ref": "#/$defs/text"
    },
    "role": {
      "$ref": "#/$defs/text"
    },
    "fiction_note": {
      "$ref": "#/$defs/text"
    },
    "future_note": {
      "$ref": "#/$defs/text"
    },
    "ui": {
      "type": "object",
      "required": [
        "launcher",
        "launcher_hint",
        "close",
        "guide",
        "conversation",
        "intro_tag",
        "lesson_tag",
        "progress",
        "previous",
        "next",
        "begin_guide",
        "skip",
        "replay",
        "restart",
        "finish",
        "finished",
        "finished_body",
        "show_me",
        "active_village_needed",
        "battle_navigation_blocked",
        "chapter_note",
        "hear",
        "hear_hint",
        "explain_prompt",
        "connect",
        "disconnect",
        "mute",
        "unmute",
        "connection_note",
        "context_note",
        "setup_note",
        "placeholder",
        "send",
        "you",
        "empty_chat",
        "working",
        "question_too_long",
        "ask_supplies",
        "ask_building",
        "ask_next",
        "reference_mode",
        "village_mode",
        "no_history",
        "no_known_incident",
        "not_connected",
        "lesson_source",
        "review_season",
        "season_title",
        "season_help",
        "season_quiet",
        "season_more",
        "presentation_navigation_blocked",
        "city_view_needed",
        "battle_context_note"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "status": {
      "type": "object",
      "required": [
        "unconfigured",
        "disconnected",
        "connecting",
        "connected",
        "thinking",
        "speaking",
        "muted",
        "setup_required",
        "broker_unavailable",
        "broker_rejected",
        "connection_failed",
        "connection_timeout",
        "unsupported_audio",
        "protocol_error",
        "audio_overflow",
        "response_timeout",
        "idle_timeout",
        "agent_busy",
        "unavailable"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "intro": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "body",
          "counsel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "body": {
            "$ref": "#/$defs/text"
          },
          "counsel": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "lesson_counsel": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_characters",
        "conversation_entries",
        "context_reports",
        "context_settlements",
        "context_forces",
        "context_factors"
      ],
      "properties": {
        "question_characters": {
          "type": "integer",
          "minimum": 100,
          "maximum": 4000
        },
        "conversation_entries": {
          "type": "integer",
          "minimum": 4,
          "maximum": 100
        },
        "context_reports": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "context_settlements": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "context_forces": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "context_factors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "body",
          "destination"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "body": {
            "$ref": "#/$defs/text"
          },
          "destination": {
            "enum": [
              "capital",
              "construction",
              "orders",
              "dispatch",
              "city_ledger"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  }
}
