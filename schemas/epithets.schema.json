{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epithets.schema.json",
  "title": "Epithets (names earned by deeds, one per man, ever)",
  "type": "object",
  "required": ["epithets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "epithets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "historical_basis", "precedence", "requires", "limits"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "historical_basis": { "type": "string", "minLength": 40 },
          "precedence": {
            "type": "integer", "minimum": 1,
            "description": "Lower checks first; the first name earned sticks for life (ties broken by id)"
          },
          "requires": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "patternProperties": { "^[a-z_]+$": { "type": "integer", "minimum": 1 } },
            "propertyNames": { "$ref": "#/$defs/deed" }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": { "^[a-z_]+$": { "type": "integer", "minimum": 0 } },
            "propertyNames": { "$ref": "#/$defs/deed" },
            "description": "Deed counts that must not EXCEED the value (a spotless record)"
          }
        }
      }
    }
  },
  "$defs": {
    "deed": {
      "enum": ["battles_won", "battles_lost", "sieges_won", "cities_taken",
        "cities_lost", "techniques_completed", "edicts_enacted", "offices_held"]
    }
  }
}
