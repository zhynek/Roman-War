{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "win_conditions.schema.json",
  "title": "Victory conditions per faction",
  "type": "object",
  "required": ["conditions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["faction", "campaign", "hold_regions_count"],
        "additionalProperties": false,
        "properties": {
          "faction": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "campaign": { "enum": ["long", "short"] },
          "hold_regions_count": { "type": "integer", "minimum": 1 },
          "must_hold_regions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "uniqueItems": true
          },
          "outlive_factions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "uniqueItems": true,
            "description": "These factions must be destroyed (or the game must end with them destroyed)"
          },
          "requires_civil_war_victory": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
