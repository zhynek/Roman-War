{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mercenaries.schema.json",
  "title": "Regional mercenary pools",
  "type": "object",
  "required": ["pools"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "regions", "units"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "uniqueItems": true
          },
          "units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["template", "max", "replenish_per_turn", "cost_multiplier"],
              "additionalProperties": false,
              "properties": {
                "template": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "max": { "type": "integer", "minimum": 1, "maximum": 10 },
                "initial": { "type": "integer", "minimum": 0, "maximum": 10 },
                "replenish_per_turn": { "type": "number", "minimum": 0, "maximum": 1 },
                "cost_multiplier": { "type": "number", "minimum": 1, "maximum": 3 }
              }
            }
          }
        }
      }
    }
  }
}
