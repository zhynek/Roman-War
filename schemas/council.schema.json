{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ui",
    "speakers",
    "discussion"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "ui": {
      "type": "object",
      "minProperties": 40,
      "additionalProperties": {
        "$ref": "#/$defs/text"
      },
      "required": [
        "council",
        "patronage",
        "title",
        "source",
        "help",
        "latest",
        "stale",
        "no_season",
        "reports",
        "quiet",
        "omitted",
        "city",
        "survey",
        "no_city",
        "tax",
        "public_order",
        "growth",
        "income",
        "factors_limited",
        "city_question",
        "ask",
        "question",
        "lucius_locked",
        "battle",
        "presentation",
        "return",
        "mandate",
        "patronage_title",
        "patronage_help",
        "divine_source",
        "mission",
        "tradeoff",
        "temples",
        "temple_seat",
        "temple_needed",
        "select_seat",
        "pledge",
        "confirm_title",
        "confirm_pledge",
        "confirm_renounce",
        "confirm",
        "cancel",
        "renounce",
        "chosen",
        "progress",
        "awaiting",
        "fulfilled",
        "remembered",
        "temple_lost",
        "pledged",
        "renounced",
        "changed",
        "blocked",
        "finished",
        "hear_council",
        "live_title",
        "live_source",
        "live_help",
        "live_ready",
        "live_needs_context",
        "live_connecting",
        "live_discussing",
        "live_complete",
        "live_stopped",
        "live_context_changed",
        "live_timeout",
        "live_unavailable",
        "live_too_long",
        "live_too_large",
        "live_stop",
        "live_mute",
        "live_unmute",
        "live_snapshot",
        "live_empty"
      ]
    },
    "speakers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marcus",
        "lucius",
        "gaius"
      ],
      "properties": {
        "marcus": {
          "$ref": "#/$defs/speaker"
        },
        "lucius": {
          "$ref": "#/$defs/speaker"
        },
        "gaius": {
          "$ref": "#/$defs/speaker"
        }
      }
    },
    "discussion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limits",
        "prompt"
      ],
      "properties": {
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turns",
            "words",
            "response_characters",
            "speaker_seconds",
            "session_seconds",
            "snapshot_bytes",
            "greeting_settle_ms"
          ],
          "properties": {
            "turns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "words": {
              "type": "integer",
              "minimum": 20,
              "maximum": 80
            },
            "response_characters": {
              "type": "integer",
              "minimum": 200,
              "maximum": 1000
            },
            "speaker_seconds": {
              "type": "integer",
              "minimum": 15,
              "maximum": 60
            },
            "session_seconds": {
              "type": "integer",
              "minimum": 30,
              "maximum": 180
            },
            "snapshot_bytes": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 18000
            },
            "greeting_settle_ms": {
              "type": "integer",
              "minimum": 500,
              "maximum": 1500
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "stance",
        "counsel",
        "city",
        "season",
        "patrons",
        "locked"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "stance": {
          "$ref": "#/$defs/text"
        },
        "counsel": {
          "$ref": "#/$defs/text"
        },
        "city": {
          "$ref": "#/$defs/text"
        },
        "season": {
          "$ref": "#/$defs/text"
        },
        "patrons": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zeus",
            "ares"
          ],
          "properties": {
            "zeus": {
              "$ref": "#/$defs/text"
            },
            "ares": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "locked": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
