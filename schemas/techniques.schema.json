{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "techniques.schema.json",
  "title": "Techniques (the knowledge of the ancient world)",
  "type": "object",
  "required": ["techniques"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "techniques": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "name", "domain", "historical_basis", "start_adopted",
          "origin_cultures", "prerequisites", "adoption", "culture_resistance",
          "effects"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": {
            "type": "string", "minLength": 1,
            "description": "One line on what practicing it changes in the field (the knowledge scroll shows it)"
          },
          "domain": {
            "enum": ["warcraft", "military_engineering", "naval", "agrarian", "hydraulic_civic",
              "metallurgy_craft", "medicine", "scholarship_statecraft", "logistics_trade"],
            "description": "warcraft = drill, formations and the traditions of the arms — the techniques that carry a `war` block"
          },
          "historical_basis": { "type": "string", "minLength": 40 },
          "start_adopted": {
            "type": "object",
            "required": ["cultures", "factions"],
            "additionalProperties": false,
            "properties": {
              "cultures": { "type": "array", "items": { "$ref": "#/$defs/culture" } },
              "factions": { "type": "array", "items": { "type": "string" } }
            }
          },
          "origin_cultures": {
            "type": "array",
            "items": { "$ref": "#/$defs/culture" },
            "description": "Cultures that can independently originate it; empty = anyone meeting the prerequisites"
          },
          "factions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" },
            "description": "A tradition closed to every court but these: only they may originate, hear of, or take it up (the Seleucid elephant corps)"
          },
          "prerequisites": {
            "type": "object",
            "required": ["building_kind", "building_level", "resource", "hidden_resource", "coastal", "techniques"],
            "additionalProperties": false,
            "properties": {
              "building_kind": {
                "enum": ["", "government", "walls", "barracks", "stables", "archery_range",
                  "siege_workshop", "armoury", "naval", "market", "farms", "roads", "port", "mines",
                  "health", "entertainment", "execution", "education", "temple"]
              },
              "building_level": { "type": "integer", "minimum": 0 },
              "resource": { "type": "string" },
              "hidden_resource": { "type": "string" },
              "coastal": { "type": "boolean" },
              "techniques": { "type": "array", "items": { "type": "string" } },
              "era": { "enum": ["pre_marian", "post_marian"], "description": "The court's military era must match" },
              "battles_won": { "type": "integer", "minimum": 1, "description": "War record: battles the court has won" },
              "battles_lost": { "type": "integer", "minimum": 1, "description": "War record: battles the court has lost (defeat teaches)" },
              "faced": {
                "type": "object",
                "required": ["class", "battles"],
                "additionalProperties": false,
                "properties": {
                  "class": { "$ref": "#/$defs/unit_class" },
                  "battles": { "type": "integer", "minimum": 1 }
                },
                "description": "War record: the court must have fought armies fielding this class in at least this many battles"
              }
            },
            "description": "Every present key must hold (AND); the war-record keys read CombatRules.record_battle's ledger"
          },
          "adoption": {
            "type": "object",
            "required": ["cost", "turns"],
            "additionalProperties": false,
            "properties": {
              "cost": { "type": "integer", "minimum": 0 },
              "turns": { "type": "integer", "minimum": 1 }
            }
          },
          "culture_resistance": {
            "type": "object",
            "additionalProperties": false,
            "propertyNames": { "$ref": "#/$defs/culture" },
            "patternProperties": {
              "^[a-z]+$": { "type": "number", "minimum": 1.0, "maximum": 3.0 }
            }
          },
          "effects": {
            "type": "object",
            "minProperties": 0,
            "additionalProperties": false,
            "description": "Flat, summed faction-wide through KnowledgeRules.faction_effect_total; a technique with an empty `effects` must carry a `war` block (the validator checks)",
            "properties": {
              "growth": { "type": "number" },
              "happiness": { "type": "number" },
              "trade_pct": { "type": "number" },
              "farm_income_pct": { "type": "number" },
              "mine_income_pct": { "type": "number" },
              "plague_resistance": { "type": "number" },
              "corruption_reduction_pct": { "type": "number" },
              "weapon_upgrade": { "type": "integer", "minimum": 1, "maximum": 2 },
              "armor_upgrade": { "type": "integer", "minimum": 1, "maximum": 2 },
              "recruit_xp": { "type": "integer", "minimum": 1, "maximum": 3 },
              "naval_movement_pct": { "type": "number" },
              "movement_points": { "type": "number" },
              "siege_equipment_turns_delta": { "type": "integer", "maximum": 0 },
              "wall_level_bonus": { "type": "integer", "minimum": 1, "maximum": 2 },
              "scholarship": { "type": "number", "minimum": 0 },
              "build_cost_pct": { "type": "number", "maximum": 0 },
              "battle_strength_pct": { "type": "number" },
              "attacking_pct": { "type": "number" },
              "assault_pct": { "type": "number" },
              "wall_defense_pct": { "type": "number" },
              "pursuit_pct": { "type": "number" },
              "escape_pct": { "type": "number" },
              "upgrade_cap": { "type": "integer", "minimum": 1, "maximum": 1 },
              "garrison_order_pct": { "type": "number" },
              "levy_strain_pct": { "type": "number" },
              "mercenary_cost_pct": { "type": "number" }
            }
          },
          "war": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "description": "Per-class tables the battle model reads (KnowledgeRules.war_effects / army_mods): additive across a court's practiced techniques",
            "properties": {
              "class_stats": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["class"],
                  "minProperties": 2,
                  "additionalProperties": false,
                  "properties": {
                    "class": { "$ref": "#/$defs/unit_class" },
                    "attack": { "type": "number" },
                    "defense": { "type": "number" },
                    "morale": { "type": "number" },
                    "charge": { "type": "number" },
                    "missile_attack": { "type": "number" }
                  }
                }
              },
              "matchups": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["class", "versus", "pct"],
                  "additionalProperties": false,
                  "properties": {
                    "class": { "$ref": "#/$defs/unit_class" },
                    "versus": { "$ref": "#/$defs/unit_class" },
                    "pct": { "type": "number" }
                  }
                }
              },
              "terrain": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["class", "terrain", "pct"],
                  "additionalProperties": false,
                  "properties": {
                    "class": { "$ref": "#/$defs/unit_class_or_all" },
                    "terrain": { "$ref": "#/$defs/terrain" },
                    "pct": { "type": "number" }
                  }
                }
              },
              "upkeep_pct": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["class", "pct"],
                  "additionalProperties": false,
                  "properties": {
                    "class": { "$ref": "#/$defs/unit_class" },
                    "pct": { "type": "number" }
                  }
                }
              },
              "recruit_xp": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["class", "xp"],
                  "additionalProperties": false,
                  "properties": {
                    "class": { "$ref": "#/$defs/unit_class_or_all" },
                    "xp": { "type": "integer", "minimum": 1, "maximum": 3 }
                  }
                }
              },
              "fatigue_immune": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "culture": {
      "enum": ["roman", "greek", "eastern", "carthaginian", "egyptian", "barbarian", "neutral"]
    },
    "unit_class": {
      "enum": ["infantry", "spear", "pike", "missile", "cavalry", "horse_archer", "chariot", "elephant", "siege", "ship", "general_bodyguard", "peasant"]
    },
    "unit_class_or_all": {
      "enum": ["all", "infantry", "spear", "pike", "missile", "cavalry", "horse_archer", "chariot", "elephant", "siege", "ship", "general_bodyguard", "peasant"]
    },
    "terrain": { "enum": ["plains", "forest", "hills", "mountains", "desert", "steppe", "marsh"] }
  }
}
