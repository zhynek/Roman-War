{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary.schema.json",
  "title": "Display glossary: names and one-line explanations for data vocabulary",
  "description": "The UI's vocabulary for ids the engine otherwise shows raw: unit classes, unit attributes, building effect keys, building kinds. The validator cross-checks every section against actual data usage in both directions.",
  "type": "object",
  "required": ["unit_classes", "attributes", "effects", "building_kinds"],
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "name", "blurb"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "blurb": { "type": "string", "minLength": 1 }
      }
    },
    "section": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "unit_classes": { "$ref": "#/$defs/section" },
    "attributes": { "$ref": "#/$defs/section" },
    "effects": { "$ref": "#/$defs/section" },
    "building_kinds": { "$ref": "#/$defs/section" }
  }
}
