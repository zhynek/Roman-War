{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "society.schema.json",
  "title": "Society — the names, descriptions and historical patterns of the societal layer",
  "type": "object",
  "required": ["axes", "unrest_states", "patterns", "clarity_levels"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "scope", "description", "raised_by", "lowered_by"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string" },
          "scope": { "type": "string", "enum": ["settlement", "faction"] },
          "description": { "type": "string" },
          "raised_by": { "type": "string" },
          "lowered_by": { "type": "string" }
        }
      }
    },
    "unrest_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["calm", "restive", "rebellious"] },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "historical_note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "historical_note": { "type": "string" }
        }
      }
    },
    "clarity_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["exact", "banded", "rumour"] },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
