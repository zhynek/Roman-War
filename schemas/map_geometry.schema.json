{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map_geometry.schema.json",
  "title": "Campaign map geometry: coastlines, province polygons, road paths",
  "description": "Generated by tools/generate_map_geometry.py from regions.json — regenerate, never hand-edit. Coordinates live in the same 0-100 map space as region positions; boundary tracing may overshoot the frame by half a raster cell.",
  "type": "object",
  "required": ["meta", "landmasses", "cells", "edges"],
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": -2, "maximum": 102 }
    },
    "ring": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/point" }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["seed", "grid", "world_size", "tool"],
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer", "description": "Noise seed; the same seed reproduces the file byte for byte" },
        "grid": { "type": "integer", "minimum": 100 },
        "world_size": { "type": "integer", "minimum": 1 },
        "tool": { "type": "string", "minLength": 1 }
      }
    },
    "landmasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "outline"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^landmass_[0-9]+$" },
          "outline": { "$ref": "#/$defs/ring", "description": "Coastline ring, largest landmass first" }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["region", "polygons", "label"],
        "additionalProperties": false,
        "properties": {
          "region": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "polygons": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/ring" },
            "description": "The region's territory; may be several fragments on a ragged coast"
          },
          "label": { "$ref": "#/$defs/point", "description": "Deepest-inland point, for map labels" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["a", "b", "path"],
        "additionalProperties": false,
        "properties": {
          "a": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "b": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Lexicographically after a" },
          "path": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/$defs/point" },
            "description": "Road polyline over land between the two region positions"
          }
        }
      }
    }
  }
}
