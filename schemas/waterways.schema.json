{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "river_nodes",
    "links",
    "transport_template",
    "shallow_templates"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "river_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "position",
          "regions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "regions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "a",
          "b",
          "kind",
          "distance"
        ],
        "properties": {
          "a": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "b": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "river",
              "coastal",
              "open"
            ]
          },
          "distance": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2
          }
        }
      }
    },
    "transport_template": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "shallow_templates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  }
}
