{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doctrines.schema.json",
  "title": "Military doctrines: faction-level reforms adopted for denarii and turns behind prerequisites",
  "type": "object",
  "required": ["doctrines"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "unit_class": {
      "enum": ["infantry", "spear", "pike", "missile", "cavalry", "horse_archer", "chariot", "elephant", "siege", "ship", "general_bodyguard", "peasant"]
    },
    "unit_class_or_all": {
      "enum": ["all", "infantry", "spear", "pike", "missile", "cavalry", "horse_archer", "chariot", "elephant", "siege", "ship", "general_bodyguard", "peasant"]
    },
    "terrain": { "enum": ["plains", "forest", "hills", "mountains", "desert", "steppe", "marsh"] },
    "building_kind": {
      "enum": ["government", "walls", "barracks", "stables", "archery_range", "siege_workshop", "armoury", "naval", "market", "farms", "roads", "port", "mines", "health", "entertainment", "execution", "education", "temple"]
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "doctrines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "cultures", "cost", "turns", "effects", "historical_note", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "cultures": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["roman", "greek", "eastern", "carthaginian", "egyptian", "barbarian"] },
            "description": "Cultures whose factions may adopt it (unless `factions` narrows it further); the neutral rebels reform nothing"
          },
          "factions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" },
            "description": "Optional: only these factions may adopt it (their cultures must be listed above)"
          },
          "era": { "enum": ["pre_marian", "post_marian", "any"], "default": "any" },
          "cost": { "type": "integer", "minimum": 0 },
          "turns": { "type": "integer", "minimum": 1 },
          "prerequisites": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "doctrines": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
              "building": {
                "type": "object",
                "required": ["kind", "level"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "$ref": "#/$defs/building_kind" },
                  "level": { "type": "integer", "minimum": 1, "maximum": 6 }
                },
                "description": "Some owned settlement must hold this kind at this tier"
              },
              "resource": { "type": "string", "description": "Some owned region must produce this resource" },
              "battles_won": { "type": "integer", "minimum": 0 },
              "battles_lost": { "type": "integer", "minimum": 0 },
              "faced": {
                "type": "object",
                "required": ["class", "battles"],
                "additionalProperties": false,
                "properties": {
                  "class": { "$ref": "#/$defs/unit_class" },
                  "battles": { "type": "integer", "minimum": 1 }
                },
                "description": "The faction must have fought armies containing this class in at least this many battles"
              }
            },
            "description": "Every present key must hold (AND)"
          },
          "effects": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "class_stats": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["class"],
                  "minProperties": 2,
                  "additionalProperties": false,
                  "properties": {
                    "class": { "$ref": "#/$defs/unit_class" },
                    "attack": { "type": "number" },
                    "defense": { "type": "number" },
                    "morale": { "type": "number" },
                    "charge": { "type": "number" },
                    "missile_attack": { "type": "number" }
                  }
                }
              },
              "matchups": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["class", "versus", "pct"],
                  "additionalProperties": false,
                  "properties": {
                    "class": { "$ref": "#/$defs/unit_class" },
                    "versus": { "$ref": "#/$defs/unit_class" },
                    "pct": { "type": "number" }
                  }
                }
              },
              "terrain": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["class", "terrain", "pct"],
                  "additionalProperties": false,
                  "properties": {
                    "class": { "$ref": "#/$defs/unit_class_or_all" },
                    "terrain": { "$ref": "#/$defs/terrain" },
                    "pct": { "type": "number" }
                  }
                }
              },
              "strength_pct": { "type": "number" },
              "attacking_pct": { "type": "number" },
              "assault_pct": { "type": "number" },
              "wall_defense_pct": { "type": "number" },
              "pursuit_pct": { "type": "number" },
              "escape_pct": { "type": "number" },
              "fatigue_immune": { "type": "boolean" },
              "upkeep_pct": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["class", "pct"],
                  "additionalProperties": false,
                  "properties": {
                    "class": { "$ref": "#/$defs/unit_class" },
                    "pct": { "type": "number" }
                  }
                }
              },
              "recruit_xp": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["class", "xp"],
                  "additionalProperties": false,
                  "properties": {
                    "class": { "$ref": "#/$defs/unit_class_or_all" },
                    "xp": { "type": "integer", "minimum": 0, "maximum": 3 }
                  }
                }
              },
              "upgrade_cap": { "type": "integer" },
              "siege_equipment_turns": { "type": "integer" },
              "garrison_order_pct": { "type": "number" },
              "levy_strain_pct": { "type": "number" },
              "movement": { "type": "number" },
              "mercenary_cost_pct": { "type": "number" }
            },
            "description": "Closed vocabulary; every key has an engine reader (the validator checks)"
          },
          "historical_note": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
