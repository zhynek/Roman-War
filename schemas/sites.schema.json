{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sites.schema.json",
  "title": "Points of interest the player can explore",
  "type": "object",
  "required": ["sites"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "region", "name", "kind", "text", "outcomes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "region": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["cache", "ruin", "deserters", "shrine", "watchpost"] },
          "text": { "type": "string", "minLength": 1 },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["weight", "text", "reward"],
              "additionalProperties": false,
              "properties": {
                "weight": { "type": "integer", "minimum": 1 },
                "text": { "type": "string", "minLength": 1 },
                "reward": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "treasury": { "type": "integer", "minimum": 1 },
                    "units": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["template", "count"],
                        "additionalProperties": false,
                        "properties": {
                          "template": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                          "count": { "type": "integer", "minimum": 1, "maximum": 4 }
                        }
                      }
                    },
                    "experience": { "type": "integer", "minimum": 1, "maximum": 3 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
