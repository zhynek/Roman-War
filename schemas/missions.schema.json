{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "missions.schema.json",
  "title": "Senate mission templates",
  "type": "object",
  "required": ["missions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "missions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "deadline_turns", "reward", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["take_region", "blockade_port", "make_alliance", "reach_trade_agreement", "assassinate_leader", "leader_suicide"] },
          "deadline_turns": { "type": "integer", "minimum": 1 },
          "min_year": { "type": "integer", "description": "Not offered before this year" },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "treasury": { "type": "integer" },
              "senate_standing": { "type": "number" },
              "units": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["template", "count"],
                  "additionalProperties": false,
                  "properties": {
                    "template": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                    "count": { "type": "integer", "minimum": 1, "maximum": 8 }
                  }
                }
              }
            }
          },
          "penalty": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "senate_standing": { "type": "number" }
            }
          },
          "text": { "type": "string" }
        }
      }
    }
  }
}
