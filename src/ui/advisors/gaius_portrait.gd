extends "res://Castles and Cities/sites/yenikapi_6000_bce/experience/src/marcus_portrait.gd"
## Original fictional commander: close-cropped hair, bronze cuirass, red mantle.
func _draw() -> void:
	var edge: float=minf(size.x,size.y)
	if edge<=0:return
	draw_set_transform((size-Vector2.ONE*edge)*.5,0,Vector2.ONE*edge/100.0)
	var skin:=Color("bf9978")
	var bronze:=Color("9c8350")
	draw_circle(Vector2(50,50),48,Color("30292a"))
	draw_arc(Vector2(50,50),46,0,TAU,72,Color("b69a64"),1.2,true)
	_poly([Vector2(13,97),Vector2(22,77),Vector2(39,69),Vector2(63,69),Vector2(82,80),Vector2(89,97)],bronze)
	_poly([Vector2(13,97),Vector2(18,76),Vector2(35,69),Vector2(41,78),Vector2(35,97)],Color("86473e"))
	_poly([Vector2(36,69),Vector2(49,76),Vector2(62,68),Vector2(59,57),Vector2(39,57)],skin.darkened(.18))
	for i in range(3):draw_line(Vector2(45,84+i*5),Vector2(75,84+i*5),bronze.darkened(.3),1.6,true)
	draw_circle(Vector2(30,45),5,skin)
	draw_circle(Vector2(70,45),5,skin.darkened(.2))
	_poly([Vector2(30,29),Vector2(38,20),Vector2(58,20),Vector2(69,29),Vector2(68,52),Vector2(61,64),Vector2(49,72),Vector2(37,63),Vector2(31,51)],skin)
	_poly([Vector2(52,22),Vector2(68,30),Vector2(68,51),Vector2(60,64),Vector2(51,70),Vector2(55,50)],skin.darkened(.15))
	_poly([Vector2(28,34),Vector2(30,25),Vector2(38,18),Vector2(57,17),Vector2(69,25),Vector2(71,35),Vector2(63,29),Vector2(45,27),Vector2(35,33)],Color("5d5449"))
	for i in range(7):draw_line(Vector2(34+i*5,25),Vector2(36+i*5,30),Color("948675"),1.1,true)
	draw_line(Vector2(36,39),Vector2(45,38),Color("554b41"),2,true)
	draw_line(Vector2(55,38),Vector2(64,40),Color("554b41"),2,true)
	draw_line(Vector2(37,43),Vector2(45,43),Color("303731"),1.5,true)
	draw_line(Vector2(55,43),Vector2(63,43),Color("303731"),1.5,true)
	draw_line(Vector2(50,42),Vector2(46,55),skin.lightened(.15),2,true)
	draw_line(Vector2(46,55),Vector2(52,56),skin.darkened(.35),1,true)
	draw_ellipse_mouth(Vector2(50,62),.7+(absf(sin(elapsed*8))*1.5 if speaking else 0))
	draw_line(Vector2(39,60),Vector2(42,65),skin.darkened(.2),1,true)
	draw_circle(Vector2(33,78),4,bronze.lightened(.3))
	draw_circle(Vector2(33,78),2,bronze.darkened(.2))
	draw_set_transform(Vector2.ZERO,0,Vector2.ONE)
